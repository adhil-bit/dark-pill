{
  "manifest_version": 3,
  "name": "Dark Pill",
  "version": "1.0.0",
  "description": "A small floating pill on every page: dark/light toggle, refresh, clear cache, and close.",
  "permissions": ["storage", "browsingData", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Show / hide Dark Pill on this tab",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-pill": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Show / hide the pill on this tab"
    },
    "toggle-dark": {
      "suggested_key": { "default": "Alt+Shift+N" },
      "description": "Toggle dark mode on this site"
    }
  }
}
